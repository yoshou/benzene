# Connection settings for the VENTUNO Q (Linux side). Copy to config/board.env and edit.
# BOARD_HOST: a Host alias from ~/.ssh/config (e.g. ventunoq), <name>.local, or an IP address
# With an alias, HostName / User / IdentityFile come from ~/.ssh/config
BOARD_HOST=ventuno-q.local
BOARD_USER=arduino
BOARD_SSH_PORT=22
# Where benzene runs from on the board
BOARD_BENZENE_DIR=/home/arduino/benzene
